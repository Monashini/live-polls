# ---------------------------------------------------------------------------
# Copy this file to backend/.env and fill in real values.
# .env is gitignored. Never commit real credentials.
# In production these are set as real environment variables, not from a file.
# ---------------------------------------------------------------------------

# "development" or "production". Controls Gin's mode and cookie defaults.
APP_ENV=development

# Port the HTTP server binds to.
PORT=8080

# MongoDB connection string.
# Atlas looks like: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Local Docker looks like: mongodb://localhost:27017
MONGODB_URI=

# Logical database name inside the cluster.
MONGODB_DATABASE=livepolls

# Secret used to sign JWTs. MUST be at least 32 characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# How long an access token stays valid. Go duration syntax: 30m, 24h, 168h
JWT_TTL=24h

# Comma-separated list of browser origins allowed to call this API.
# Exact match including scheme and port. No trailing slash. No wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cookie flags for the anonymous voter cookie.
# Local dev over plain http: COOKIE_SECURE=false and COOKIE_SAMESITE=lax
# Deployed with frontend on a different domain: COOKIE_SECURE=true and COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Optional. Leave blank unless the API and frontend share a parent domain.
COOKIE_DOMAIN=

# Salt for hashing voter IP addresses. Raw IPs are never stored.
# Generate one with:  openssl rand -base64 32
# If left blank, a value is derived from JWT_SECRET.
IP_HASH_SALT=

# Comma-separated CIDRs or IPs of proxies whose X-Forwarded-For header we trust.
# Leave BLANK when running locally. Set to the platform's proxy range once
# deployed, otherwise client IPs are spoofable by anyone sending the header.
TRUSTED_PROXIES=
